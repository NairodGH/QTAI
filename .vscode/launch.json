{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (CMake)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "MIMode": "msvc",
            "preLaunchTask": "CMake: Debug",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/Qt/6.10.1/msvc2022_64/bin;${env:PATH}"
                },
                {
                    "name": "QML_IMPORT_PATH",
                    "value": "C:/Qt/6.10.1/msvc2022_64/qml"
                }
            ],
            "console": "integratedTerminal",
            "externalConsole": false
        },
        {
            "name": "Release (CMake)", 
